# ============================================================================
# VARIABLES DE ENTORNO - COCINA OCULTA POS (Backend)
# ============================================================================
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
#
# NUNCA subas el archivo .env al repositorio.
# ============================================================================

# ── Base de datos ────────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/pos_restaurante"

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test

# ── JWT ──────────────────────────────────────────────────────────────────────
# Genera claves seguras (mínimo 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REEMPLAZAR_CON_CLAVE_GENERADA_DE_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRA_CLAVE_DIFERENTE_DE_MINIMO_32_CARACTERES
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis se usa para caché de feature flags, UI config y queries frecuentes.
# Con Docker: docker run -d -p 6379:6379 redis:alpine
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────────────────────────
# URLs del frontend separadas por coma (sin espacios)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutos en ms
RATE_LIMIT_MAX_REQUESTS=2000  # máximo de peticiones por ventana

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug               # error | warn | info | debug

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Schedule de alertas de inventario (formato cron, zona: America/Bogota)
# Ejemplos: "0 * * * *" = cada hora, "*/5 * * * *" = cada 5 min
ALERT_CRON_SCHEDULE="0 * * * *"

# ── Super Admin Único ─────────────────────────────────────────────────────────
# UUID fijo del único super administrador del sistema.
# CRÍTICO: Copiar el UUID exacto que queda en DB después del seed.
# NUNCA reutilizar un UUID, NUNCA cambiarlo en producción.
# En producción es OBLIGATORIO (el arranque falla si falta). En desarrollo
# puede omitirse: se usa el UUID de desarrollo del seed.
# Generar con: node -e "console.log(require('crypto').randomUUID())"
SUPER_ADMIN_UUID=REEMPLAZAR_CON_UUID_DEL_SUPER_ADMIN

# ── Seed (siembra de datos iniciales) ─────────────────────────────────────────
# Contraseña del usuario admin que crea el seed.
# En producción es OBLIGATORIA junto con SUPER_ADMIN_UUID: el seed se niega a
# sembrar con la contraseña por defecto pública. En desarrollo puede omitirse
# (se usa 'Admin123!'). Úsala una vez para sembrar; luego cámbiala desde la app.
SEED_ADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASENA_FUERTE_DEL_ADMIN

# ── URL pública del frontend ──────────────────────────────────────────────────
# Base de los enlaces de verificación de correo y reset de contraseña.
APP_URL=http://localhost:5173

# ── Correo SMTP (verificación de email y reset de contraseña) ─────────────────
# OPCIONAL en desarrollo: sin SMTP_HOST, los correos se imprimen en la consola y
# el registro NO se rompe (fail-open). En PRODUCCIÓN configúralo con tu proveedor
# (Brevo, Resend, SendGrid, Gmail…). SMTP_SECURE=true solo para el puerto 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Krezco <no-reply@tudominio.com>
SMTP_SECURE=false

# ── Captcha Cloudflare Turnstile (anti-bots) ──────────────────────────────────
# OPCIONAL en desarrollo: sin la secret, el captcha se omite. En PRODUCCIÓN pon
# aquí la SECRET KEY (la SITE KEY va en el frontend, VITE_TURNSTILE_SITE_KEY).
# Crea un sitio gratis en https://dash.cloudflare.com → Turnstile.
TURNSTILE_SECRET_KEY=

# ── Rate limit dedicado a endpoints sensibles de auth (registro, reset) ───────
AUTH_SENSITIVE_RATE_MAX=5
AUTH_SENSITIVE_RATE_WINDOW_MS=900000   # 15 min

# ── Pagos / suscripciones (Wompi) ─────────────────────────────────────────────
# PAGOS_DRIVER: 'off' (dev/sin llaves → el sistema simula aprobaciones, no cobra
# de verdad) o 'wompi' (integración real). Con 'wompi' en PRODUCCIÓN las 4 llaves
# son OBLIGATORIAS (el arranque falla si falta alguna).
# Llaves desde el panel Wompi → Desarrolladores. Sandbox para pruebas.
PAGOS_DRIVER=off
WOMPI_BASE_URL=https://sandbox.wompi.co/v1   # producción: https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
