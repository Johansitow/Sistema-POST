# ============================================================================
# Variables para docker-compose (raíz). Cópialo a .env:
#   cp .env.production.example .env
# El .env de la raíz NO se versiona (está en .gitignore).
# Nota: la config del BACKEND (DATABASE_URL, JWT, etc.) va aparte, en
#       backend/.env.production (ver DEPLOYMENT.md).
# ============================================================================

# Dominio público que servirá el POS. Apunta su DNS (registro A) a la IP de este
# servidor. Para probar en local sin dominio real, usa: DOMAIN=localhost
DOMAIN=pos.midominio.com

# Correo para los avisos de Let's Encrypt sobre el certificado HTTPS (recomendado).
ACME_EMAIL=tu-correo@ejemplo.com
